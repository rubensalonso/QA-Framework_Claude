# Copiá este archivo a `.env` y ajustá los valores. `.env` NO se versiona.
# Todas las variables usan el prefijo QA_ y son opcionales: si no se definen, se usan los defaults
# de framework/config/settings.py. Las variables de entorno reales tienen prioridad sobre `.env`.

# --- Entorno bajo prueba ---
QA_BASE_URL=https://automationexercise.com
QA_API_BASE_URL=https://automationexercise.com/api/

# --- Timeouts (milisegundos) ---
QA_DEFAULT_TIMEOUT_MS=15000
QA_NAVIGATION_TIMEOUT_MS=30000
QA_EXPECT_TIMEOUT_MS=10000
QA_API_TIMEOUT_MS=20000

# --- Resiliencia de la capa API ---
QA_API_MAX_RETRIES=2
QA_API_RETRY_BACKOFF_S=1.0

# --- Comportamiento del navegador ---
# Bloquea publicidad de terceros (reduce flakiness y tiempo de carga).
QA_BLOCK_ADS=true

# --- Datos de prueba ---
# Fijar una semilla hace que Faker genere los mismos datos en cada corrida (útil para depurar).
# QA_FAKER_SEED=12345

# --- Logging ---
QA_LOG_LEVEL=INFO

# --- Presupuestos de performance ---
QA_PERF_TTFB_MS=2000
QA_PERF_DOM_CONTENT_LOADED_MS=6000
QA_PERF_LOAD_MS=12000
QA_PERF_LCP_MS=6000
QA_PERF_API_P95_MS=3000
QA_PERF_API_SAMPLES=5
